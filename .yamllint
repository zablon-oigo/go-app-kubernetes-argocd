---
extends: default

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true

  empty-lines:
    max: 2
    max-start: 1
    max-end: 1

  document-start: enable

  comments:
    min-spaces-from-content: 1

  indentation:
    spaces: 2
    indent-sequences: true
